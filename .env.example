# Variáveis de ambiente do Praxis CRM.
#
# Este arquivo só documenta NOMES e o que cada um significa — nenhum valor
# real. Copie para `.env.local` (já ignorado pelo git) e preencha com as
# credenciais do projeto Supabase `praxis-crm-dev` — exclusivo de
# desenvolvimento. Nunca aponte isto para produção.

# --- Supabase — projeto de desenvolvimento (praxis-crm-dev) -------------
# Project URL e Publishable Key (o par que a Supabase chama hoje de
# "anon"/"publishable" — mesma coisa, nome novo). São as DUAS ÚNICAS
# credenciais Supabase que a aplicação usa em runtime. Seguras para o
# navegador de propósito: a Publishable Key não concede nada sozinha — é a
# RLS que decide o que cada sessão vê. Painel do projeto → Project Settings
# → API, ou `supabase status` se algum dia rodar local via `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret Key (o antigo "service_role") do MESMO projeto. NUNCA prefixar com
# NEXT_PUBLIC_, nunca no navegador, nunca na Vercel Preview, nunca importar
# fora de src/server/supabase/admin.ts (regra de lint em eslint.config.mjs
# barra qualquer outra importação), nunca logar. A A2 inteira — inclusive o
# fluxo de convites — deliberadamente NÃO usa esta chave; ela nem chega a
# ser necessária até uma fase com webhook ou job. Deixe em branco por
# enquanto: nenhum código desta fase a lê.
SUPABASE_SECRET_KEY=

# --- Cookie de workspace ativo -------------------------------------------
# Segredo usado para assinar (HMAC) o cookie que guarda qual workspace está
# ativo na sessão do navegador — o valor do cookie nunca é a fonte de
# verdade (o servidor sempre revalida a membership a cada request), a
# assinatura só impede que ele seja adulterado sem o servidor perceber.
# Gerar com `openssl rand -base64 32` — um valor diferente por ambiente,
# nunca reaproveitado entre dev/preview/produção.
WORKSPACE_ACTIVE_COOKIE_SECRET=

# --- Cifra de CPF/CNPJ (A3) ----------------------------------------------
# Chaves de cifra (AES-256-GCM) e blind index (HMAC-SHA256) de
# contact_sensitive — nunca a mesma chave para as duas, nunca NEXT_PUBLIC_,
# nunca logadas. Gerar com `node scripts/generate-contact-keys.mjs` (nunca
# à mão) — a saída já vem no formato das duas variáveis abaixo. Um valor
# diferente por ambiente (dev/preview/produção), nunca reaproveitado.
#
# Perder estas chaves torna os dados cifrados PERMANENTEMENTE
# irrecuperáveis — não existe chave mestra de recuperação. Procedimento
# completo de rotação/reindexação: docs/decisoes/a3-criptografia.md.
CONTACTS_ACTIVE_KEY_VERSION=
CONTACTS_KEY_VERSIONS=

# --- Ingestão pública e atribuição (A11) ---------------------------------
# Todas as variáveis abaixo são OBRIGATÓRIAS para a captação funcionar. Em
# produção e preview, a ausência de qualquer uma derruba SOMENTE as rotas
# de ingestão e de jobs, com erro genérico — nunca desliga uma proteção em
# silêncio, e nunca derruba o resto do aplicativo (o build funciona sem
# elas). Ver docs/decisoes/a11-ingestao-atribuicao.md §4.
#
# SUPABASE_SECRET_KEY (acima) passa a ser lida nesta fase: é a única forma
# de a rota pública, que não tem sessão de usuário, falar com o banco sem
# conceder EXECUTE das funções de ingestão a `anon`.

# Cifra do payload bruto dos eventos — chave EXCLUSIVA da A11, separada
# das de contatos, blind index e cookie. Mesmo formato da A3 (base64 de 32
# bytes), com uma diferença: só `cipher` (não há blind index aqui).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
A11_PAYLOAD_ACTIVE_KEY_VERSION=
A11_PAYLOAD_KEY_VERSIONS=

# HMAC do IP do visitante. O IP completo NUNCA é persistido nem enviado ao
# Upstash, a logs, auditoria ou diagnóstico — só este HMAC. Chave própria,
# separada de todas as outras (base64 de 32 bytes).
A11_IP_HMAC_KEY=

# Turnstile (Cloudflare) — chave SECRETA do widget. A verificação confere
# `success`, e também o hostname e a action esperados do endpoint.
TURNSTILE_SECRET_KEY=

# Upstash Redis — rate limit por (endpoint, HMAC do IP) e por endpoint.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Inngest — fila do worker. `webhook_event_id` é o identificador estável
# enviado, o que permite ao reconciliador republicar sem duplicar efeito.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Segredo dos endpoints de cron (`Authorization: Bearer <valor>`) — mínimo
# de 16 caracteres. Gerar com `openssl rand -base64 32`.
CRON_SECRET=

# Substitui Turnstile, rate limit e publicação por adaptadores de TESTE.
# Só vale em desenvolvimento local e no CI: o código RECUSA este modo
# quando VERCEL_ENV é `production` ou `preview`, mesmo com a variável
# presente. Deixe em branco fora de teste.
A11_INGEST_MODE=
